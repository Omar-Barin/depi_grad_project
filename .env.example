# =================================================================
# SMART INVENTORY MANAGEMENT SYSTEM (.env.example)
# Template environment variables for local Docker & production deploys
# Copy this file to .env and replace placeholder values
# =================================================================

# -----------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# -----------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=inventory_management
DB_HOST=postgres
DB_PORT=5432

# -----------------------------------------------------------------
# 2. Low-Stock Alert Microservice Configuration
# -----------------------------------------------------------------
# URL pointing to the inventory tracking backend
BACKEND_URL=http://server:8000
# Background checking frequency in seconds
CHECK_INTERVAL=15
# Inventory quantity triggering WARNING (< 10) / CRITICAL (= 0)
LOW_STOCK_THRESHOLD=10

# -----------------------------------------------------------------
# 3. Frontend Client Build Arguments
# -----------------------------------------------------------------
# Backend API URL accessible from the client browser
VITE_API_URL=http://localhost:8000
# Alert service API URL accessible from the client browser
VITE_ALERT_API_URL=http://localhost:8001

# -----------------------------------------------------------------
# 4. Monitoring & Observability Credentials (Grafana)
# -----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password_here
